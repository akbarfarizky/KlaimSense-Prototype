# PostgreSQL bersifat OPSIONAL.
# Aplikasi KlaimSense berjalan penuh dengan mock repository in-memory
# bila variabel ini tidak diisi.
#
# Untuk mengaktifkan mode PostgreSQL, isi lalu jalankan:
#   npx prisma generate
#   npx prisma db push
#   npm run db:seed
#
# DATABASE_URL="postgresql://user:password@localhost:5432/klaimsense?schema=public"
